@Comment @InProceedings{IAAI-IdealModels,
@Comment   author =	 "Peter Stone and Patrick Riley and Manuela Veloso",
@Comment   title =	 "Defining and Using Ideal Teammate and Opponent
@Comment                   Models",
@Comment   booktitle =	 iaai2000,
@Comment   year =	 2000,
@Comment   abstract =	 {A common challenge for agents in multiagent systems
@Comment                   is trying to predict what other agents are going to
@Comment                   do in the future. Such knowledge can help an agent
@Comment                   determine which of its current action options is
@Comment                   most likely to achieve its goals. There is a long
@Comment                   history in adversarial game playing of using a model
@Comment                   of an opponent which assumes that it always acts
@Comment                   optimally. Our research extends this strategy to
@Comment                   adversarial domains in which the agents have
@Comment                   incomplete information, noisy sensors and actuators,
@Comment                   and a continuous action space. We introduce
@Comment                   ``ideal-model-based behavior outcome prediction''
@Comment                   (IMBBOP) which models the results of other agents'
@Comment                   future actions in relation to their optimal actions
@Comment                   based on an ideal world model. Our technique also
@Comment                   includes a method for relaxing this optimality
@Comment                   assumption. IMBBOP was a key component of our
@Comment                   successful CMU<SMALL>NITED-99</SMALL> simulated
@Comment                   robotic soccer application. In this paper, we define
@Comment                   IMBBOP and illustrate its use within the simulated
@Comment                   robotic soccer domain. We include empirical results
@Comment                   demonstrating the effectiveness of IMBBOP.},
@Comment   wwwnote =	 {<a href=http://www.aaai.org>AAAI Homepage</a>},
@Comment   bib2html_pubtype = {Refereed Conference},
@Comment   bib2html_rescat = {Opponent and Teammate Modelling and Classification},
@Comment }

