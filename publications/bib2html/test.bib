@Comment @InProceedings{AIPS02-STN,
@Comment   author =	 {Patrick Riley and Manuela Veloso},
@Comment   title =	 {Planning for Distributed Execution Through Use of
@Comment                   Probabilistic Opponent Models},
@Comment   booktitle =	 aips2002,
@Comment   year =	 2002,
@Comment   wwwnote =	 {Won a <b>Best Paper Award</b>. <a href="http://www.aaai.org">Publisher (AAAI) Website</a>},
@Comment   abstract =	 { In multiagent domains with adversarial and
@Comment                   cooperative team agents, team agents should be
@Comment                   adaptive to the current environment and opponent. We
@Comment                   introduce an online method to provide the agents
@Comment                   with team plans that a ``coach'' agent generates in
@Comment                   response to the specific opponents. The coach agent
@Comment                   can observe the agents' behaviors but it has only
@Comment                   periodic communication with the rest of the
@Comment                   team. The coach uses a Simple Temporal Network to
@Comment                   represent team plans as coordinated movements among
@Comment                   the multiple agents and the coach searches for an
@Comment                   opponent-dependent plan for its teammates. This plan
@Comment                   is then communicated to the agents, who execute the
@Comment                   plan in a distributed fashion, using information
@Comment                   from the plan to maintain consistency among the team
@Comment                   members. In order for these plans to be effective
@Comment                   and adaptive, models of opponent movement are used
@Comment                   in the planning. The coach is then able to quickly
@Comment                   select between different models online by using a
@Comment                   Bayesian style update on a probability distribution
@Comment                   over the models. Planning then uses the model which
@Comment                   is found to be the most likely. The system is fully
@Comment                   implemented in a simulated robotic soccer
@Comment                   environment. In several recent games with completely
@Comment                   unknown adversarial teams, the approach demonstrated
@Comment                   a visible adaptation to the different teams. },
@Comment   bib2html_pubtype = {Refereed Conference,Award Winner},
@Comment   bib2html_rescat = {Planning},
@Comment }

