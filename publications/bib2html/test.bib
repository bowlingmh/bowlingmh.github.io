@Comment @InCollection{DARS-AdvClass,
@Comment   author =	 {Patrick Riley and Manuela Veloso},
@Comment   title =	 {On Behavior Classification in Adversarial
@Comment                   Environments},
@Comment   booktitle =	 {Distributed Autonomous Robotic Systems 4},
@Comment   pages =	 {371--380},
@Comment   publisher =	 {Springer-Verlag},
@Comment   year =	 2000,
@Comment   editor =	 {Lynne E. Parker and George Bekey and Jacob Barhen},
@Comment   abstract =	 {In order for robotic systems to be successful in
@Comment                   domains with other agents possibly interfering with
@Comment                   the accomplishing of goals, the agents must be able
@Comment                   to adapt to the opponents' behavior. The more
@Comment                   quickly the agents can respond to a new situation,
@Comment                   the better they will perform. We present an approach
@Comment                   to doing adaptation which relies on classification
@Comment                   of the current adversary into predefined adversary
@Comment                   classes. For feature extraction, we present a
@Comment                   windowing technique to abstract useful but not
@Comment                   overly complicated features. In order to take into
@Comment                   account the spatial locality of topological
@Comment                   differences, we use a previously developed
@Comment                   similarity metric. The feature extraction and
@Comment                   classification steps are fully implemented in the
@Comment                   domain of simulated robotic soccer, and experimental
@Comment                   results are presented. },
@Comment   bib2html_pubtype = {Refereed Conference},
@Comment   bib2html_rescat = {Opponent and Teammate Modelling and Classification},
@Comment }

