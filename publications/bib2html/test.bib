@Comment @incollection(ATAL-LD,
@Comment   author =	 {Patrick Riley and Peter Stone and Manuela Veloso},
@Comment   title =	 {Layered Disclosure: Revealing Agents' Internals},
@Comment   booktitle =	 {Intelligent Agents VII. Agent Theories,
@Comment                   Architectures, and Languages --- 7th.~International
@Comment                   Workshop, ATAL-2000, Boston, MA, USA, July 7--9,
@Comment                   2000, Proceedings},
@Comment   editor =	 "C.~Castelfranchi and Y.~Lesp\'{e}rance",
@Comment   publisher =	 "Springer-Verlag, Berlin",
@Comment   address =	 {Berlin},
@Comment   series =	 "Lecture Notes in Artificial Intelligence",
@Comment   year =	 2001,
@Comment   wwwnote =      {<a href=http://www.springer.de/comp/lncs/index.html>Publisher's Webpage</a>&copy Springer-Verlag},
@Comment   abstract =	 {A perennial challenge in creating and using complex
@Comment                   autonomous agents is following their choices of
@Comment                   actions as the world changes dynamically and
@Comment                   understanding why they act as they do. This paper
@Comment                   reports on our work to support human developers and
@Comment                   observers to better follow and understand the
@Comment                   actions of autonomous agents. We introduce the
@Comment                   concept of {\it layered disclosure} by which
@Comment                   autonomous agents have included in their
@Comment                   architecture the foundations necessary to allow them
@Comment                   to disclose upon request the specific reasons for
@Comment                   their actions. Layered disclosure hence goes beyond
@Comment                   standard plain code debugging tools. In its essence
@Comment                   it also gives the agent designer the ability to
@Comment                   define an appropriate information hierarchy, which
@Comment                   can include agent-specific constructs such as
@Comment                   internal state that persists over time. The user may
@Comment                   request this information at any of the specified
@Comment                   levels of detail, and either retroactively or while
@Comment                   the agent is acting. We present layered disclosure
@Comment                   as we created and implemented it in the simulated
@Comment                   robotic soccer domain. We contribute the detailed
@Comment                   and principled design to support the application of
@Comment                   layered disclosure to other agent domains. Layered
@Comment                   disclosure played an important role in our
@Comment                   successful development of the RoboCup undefeated
@Comment                   champion \mbox{CMUnited-99} multiagent team. },
@Comment   bib2html_pubtype = {Refereed Conference},
@Comment   bib2html_rescat = {Other},
@Comment )

