@Comment @TechReport{SeniorThesis,
@Comment   author =	 "Patrick Riley",
@Comment   title =	 "Classifying Adversarial Behaviors in a Dynamic,
@Comment                   Inaccessible, Multi-Agent Environment",
@Comment   institution =	 "Carnegie Mellon University",
@Comment   year =	 1999,
@Comment   number =	 "CMU-CS-99-175",
@Comment   abstract =	 {Developing intelligent agents for multi-agent,
@Comment                   inaccessible, adversarial environments is arguably
@Comment                   one of the most challenging areas in artificial
@Comment                   intelligence today. Great strides have been made in
@Comment                   developing emergent cooperation among teammates, but
@Comment                   less progress has been made in quickly and
@Comment                   automatically changing overall team strategy in
@Comment                   response to adversary actions. One way that humans
@Comment                   do such adaptation is by noting a similarity to a
@Comment                   past adversary. This project is a system to do that
@Comment                   sort of classification. The system is fully
@Comment                   implemented in the simulated robotic soccer
@Comment                   environment as used in RoboCup. The system does the
@Comment                   following: Each agent observes the adversary and
@Comment                   records relevant features. Based on these
@Comment                   observations, each agent then classifies the
@Comment                   adversary with regards to a set of predefined
@Comment                   behavioral classes. The agents record their
@Comment                   classification, and the team classification is
@Comment                   decided by a simple majority. The effectiveness of
@Comment                   this system on some simple behavior classes is
@Comment                   shown. Future directions can include machine
@Comment                   learning of behavior classes and strategy changes
@Comment                   for those behavior classes, as well as developing
@Comment                   more complicated classes. },
@Comment   bib2html_pubtype = {Tech Report},
@Comment   bib2html_rescat = {Opponent and Teammate Modelling and Classification},
@Comment }

		  
