  bib2html_rescat="RL",
)
                  
@InProceedings(07nips-regretpoker-w-tr, 
  Title="Regret Minimization in Games with Incomplete Information",
  Author="Martin Zinkevich and Michael Johanson and Michael Bowling and Carmelo Piccione",
  AuthorNserc="{\bf Martin Zinkevich} and {\bf Michael Johanson} and Michael Bowling and Carmelo Piccione",
  Booktitle=NIPS07,
  Year="2008",
  Pages="905--912",
  Note = "A longer version is available as a University of Alberta Technical Report, TR07-14",
  NoteHtml= {A longer version is available as a University of Alberta Technical Report, <a href="https://www.cs.ualberta.ca/research/theses-publications/technical-reports/2007/tr07-14">TR07-14</a>.},
  AcceptRate="22\%",
  AcceptNumbers="217 of 975",
  Funding = "(AIF) iCORE NSERC",
  Abstract = "Extensive games are a powerful model of multiagent
                  decision-making scenarios with incomplete
                  information. Finding a Nash equilibrium for very
                  large instances of these games has received a great
                  deal of recent attention. In this paper, we describe
                  a new technique for solving large games based on
                  regret minimization.  In particular, we introduce
                  the notion of counterfactual regret, which exploits
                  the degree of incomplete information in an extensive
                  game. We show how minimizing counterfactual regret
                  minimizes overall regret, and therefore in self-play
                  can be used to compute a Nash equilibrium. We
                  demonstrate this technique in the domain of poker,
                  showing we can solve abstractions of limit Texas
                  Hold'em with as many as 10^12 states, two orders of
                  magnitude larger than previous methods.",
  bib2html_dl_pdf= "http://www.cs.ualberta.ca/~bowling/papers/07nips-regretpoker.pdf",
  bib2html_pubtype="Refereed Conference",
  bib2html_rescat="Games",
)

